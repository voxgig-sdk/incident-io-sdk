# BasicCallRouteFlow

main: kit: flow: BasicCallRouteFlow:
{
  entity: "call_route",
  kind: "basic",
  name: "BasicCallRouteFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "call_route_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "call_route_ref01",
        srcdatavar: "call_route_ref01_data",
        suffix: "_up0",
        textfield: "country_code"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-call_route_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "call_route_ref01",
        srcdatavar: "call_route_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "call_route01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-call_route_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCallRouteFlow"
}