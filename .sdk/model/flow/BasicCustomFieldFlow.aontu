# BasicCustomFieldFlow

main: kit: flow: BasicCustomFieldFlow:
{
  entity: "custom_field",
  kind: "basic",
  name: "BasicCustomFieldFlow",
  step: [
    {
      input: {
        ref: "custom_field_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "custom_field_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "custom_field_ref01",
        srcdatavar: "custom_field_ref01_data",
        suffix: "_up0",
        textfield: "catalog_type_id"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-custom_field_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "custom_field_ref01",
        srcdatavar: "custom_field_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "custom_field01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-custom_field_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "custom_field_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "custom_field01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "custom_field_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCustomFieldFlow"
}