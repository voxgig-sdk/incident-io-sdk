# BasicAlertRouteFlow

main: kit: flow: BasicAlertRouteFlow:
{
  entity: "alert_route",
  kind: "basic",
  name: "BasicAlertRouteFlow",
  step: [
    {
      input: {
        ref: "alert_route_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "alert_route_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "alert_route_ref01",
        srcdatavar: "alert_route_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-alert_route_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "alert_route_ref01",
        srcdatavar: "alert_route_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "alert_route01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-alert_route_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "alert_route_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "alert_route01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "alert_route_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAlertRouteFlow"
}