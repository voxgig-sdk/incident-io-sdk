# BasicCatalogEntryFlow

main: kit: flow: BasicCatalogEntryFlow:
{
  entity: "catalog_entry",
  kind: "basic",
  name: "BasicCatalogEntryFlow",
  step: [
    {
      i: {
        ref: "catalog_entry_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "catalog_entry_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "catalog_entry_ref01",
        srcdatavar: "catalog_entry_ref01_data",
        suffix: "_up0",
        textfield: "archived_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-catalog_entry_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "catalog_entry_ref01",
        srcdatavar: "catalog_entry_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "catalog_entry01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-catalog_entry_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "catalog_entry_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "catalog_entry01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "catalog_entry_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCatalogEntryFlow"
}