# BasicPayConfigFlow

main: kit: flow: BasicPayConfigFlow:
{
  entity: "pay_config",
  kind: "basic",
  name: "BasicPayConfigFlow",
  step: [
    {
      i: {
        ref: "pay_config_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "pay_config_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pay_config_ref01",
        srcdatavar: "pay_config_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pay_config_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pay_config_ref01",
        srcdatavar: "pay_config_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pay_config01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pay_config_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pay_config_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "pay_config01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "pay_config_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPayConfigFlow"
}