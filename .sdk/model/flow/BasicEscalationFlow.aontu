# BasicEscalationFlow

main: kit: flow: BasicEscalationFlow:
{
  entity: "escalation",
  kind: "basic",
  name: "BasicEscalationFlow",
  step: [
    {
      i: {
        ref: "escalation_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "escalation_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "escalation_ref01",
        srcdatavar: "escalation_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "escalation01"
      }

      o: "load",
      v: [
        {
