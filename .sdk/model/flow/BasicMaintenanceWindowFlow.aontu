# BasicMaintenanceWindowFlow

main: kit: flow: BasicMaintenanceWindowFlow:
{
  entity: "maintenance_window",
  kind: "basic",
  name: "BasicMaintenanceWindowFlow",
  step: [
    {
      input: {
        ref: "maintenance_window_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "maintenance_window_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "maintenance_window_ref01",
        srcdatavar: "maintenance_window_ref01_data",
        suffix: "_up0",
        textfield: "archived_at"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-maintenance_window_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "maintenance_window_ref01",
        srcdatavar: "maintenance_window_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "maintenance_window01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-maintenance_window_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "maintenance_window_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "maintenance_window01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "maintenance_window_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMaintenanceWindowFlow"
}