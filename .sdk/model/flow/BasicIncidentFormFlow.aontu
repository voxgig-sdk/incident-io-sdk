# BasicIncidentFormFlow

main: kit: flow: BasicIncidentFormFlow:
{
  entity: "incident_form",
  kind: "basic",
  name: "BasicIncidentFormFlow",
  step: [
    {
      i: {
        ref: "incident_form_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "incident_form_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "incident_form_ref01",
        srcdatavar: "incident_form_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-incident_form_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "incident_form_ref01",
        srcdatavar: "incident_form_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "incident_form01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-incident_form_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "incident_form_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "incident_form01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "incident_form_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIncidentFormFlow"
}