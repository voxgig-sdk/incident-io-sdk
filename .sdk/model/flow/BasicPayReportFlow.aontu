# BasicPayReportFlow

main: kit: flow: BasicPayReportFlow:
{
  entity: "pay_report",
  kind: "basic",
  name: "BasicPayReportFlow",
  step: [
    {
      i: {
        ref: "pay_report_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "pay_report_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pay_report_ref01",
        srcdatavar: "pay_report_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "pay_report01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-pay_report_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "pay_report_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "pay_report01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "pay_report_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPayReportFlow"
}