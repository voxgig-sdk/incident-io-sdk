# BasicAlertAttributeFlow

main: kit: flow: BasicAlertAttributeFlow:
{
  entity: "alert_attribute",
  kind: "basic",
  name: "BasicAlertAttributeFlow",
  step: [
    {
      input: {
        ref: "alert_attribute_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "alert_attribute_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "alert_attribute_ref01",
        srcdatavar: "alert_attribute_ref01_data",
        suffix: "_up0",
        textfield: "emoji"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-alert_attribute_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "alert_attribute_ref01",
        srcdatavar: "alert_attribute_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "alert_attribute01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-alert_attribute_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "alert_attribute_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "alert_attribute01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "alert_attribute_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAlertAttributeFlow"
}