# BasicIncidentAttachmentFlow

main: kit: flow: BasicIncidentAttachmentFlow:
{
  entity: "incident_attachment",
  kind: "basic",
  name: "BasicIncidentAttachmentFlow",
  step: [
    {
      i: {
        ref: "incident_attachment_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "incident_attachment_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "incident_attachment_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "incident_attachment01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "incident_attachment_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicIncidentAttachmentFlow"
}