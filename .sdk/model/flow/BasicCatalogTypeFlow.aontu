          }
        }
      ]
    }

    {
      i: {
        ref: "catalog_type_ref01",
        srcdatavar: "catalog_type_ref01_data",
        suffix: "_up0",
        textfield: "color"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-catalog_type_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "catalog_type_ref01",
        srcdatavar: "catalog_type_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "catalog_type01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-catalog_type_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "catalog_type_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "catalog_type01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
