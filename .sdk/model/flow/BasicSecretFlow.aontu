# BasicSecretFlow

main: kit: flow: BasicSecretFlow:
{
  entity: "secret",
  kind: "basic",
  name: "BasicSecretFlow",
  step: [
    {
      input: {
        ref: "secret_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "secret_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "secret_ref01",
        srcdatavar: "secret_ref01_data",
        suffix: "_up0",
        textfield: "created_at"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "secret_ref01",
        srcdatavar: "secret_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "secret01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-secret_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "secret_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "secret01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "secret_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSecretFlow"
}