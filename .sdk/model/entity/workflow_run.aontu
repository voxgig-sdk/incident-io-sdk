# Entity: workflow_run

main: kit: entity: workflow_run: {

  alias: field: {}

  fields: {
    cancelled_at: {
      fo: "date-time"
      h: "Cancelled At"
      n: "cancelled_at"
      r: false
      sh: "If the run was cancelled, this is when"
