    }
    progress: {
      h: "Progress"
      n: "progress"
      r: true
      sh: "Status of each step as it is worked"
      t: "`$ARRAY`"
    }
    scheduled_at: {
      fo: "date-time"
      h: "Scheduled At"
      n: "scheduled_at"
      r: true
      sh: "When the run was scheduled for"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "When the resource was last updated"
      t: "`$STRING`"
    }
    workflow_id: {
      h: "Workflow Id"
      n: "workflow_id"
      r: true
      sh: "Unique identifier for the underlying workflow"
      t: "`$STRING`"
    }
    workflow_name: {
      h: "Workflow Name"
      n: "workflow_name"
      r: false
