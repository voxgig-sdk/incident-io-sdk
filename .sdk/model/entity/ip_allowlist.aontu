# Entity: ip_allowlist

main: kit: entity: ip_allowlist: {

  alias: field: {}

  fields: {
    allowlist: {
      h: "Allowlist"
      n: "allowlist"
      r: true
      sh: "A list of IP addresses or CIDR prefixes to allow"
      t: "`$ARRAY`"
    }
    enabled: {
      h: "Enabled"
      n: "enabled"
      r: true
      sh: "Whether this IP allowlist is enabled or not"
      t: "`$BOOLEAN`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: false
      sh: "The time this allowlist was last updated"
      t: "`$STRING`"
    }
    version: {
      fo: "int64"
      h: "Version"
      n: "version"
      r: true
      sh: "The version of this IP allowlist"
      t: "`$INTEGER`"
    }
  }

  name: "ip_allowlist"
  op: {
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/ip_allowlists"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/v1/ip_allowlists"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "ip_allowlists"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.ip_allowlist`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          bf: [
            "allowlist"
            "enabled"
            "version"
          ]
          co: {
            id: "PUT /v1/ip_allowlists"
            source: "openapi3"
            version: 2
          }
          m: "PUT"
          o: "/v1/ip_allowlists"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "ip_allowlists"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.ip_allowlist`"
          }
        }
      ]
    }
  }



}
