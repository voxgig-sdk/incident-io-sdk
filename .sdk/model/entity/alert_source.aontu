# Entity: alert_source

main: kit: entity: alert_source: {

  alias: field: {}

  fields: {
    alert_events_url: {
      h: "Alert Events Url"
      n: "alert_events_url"
      r: false
      sh: "URL that can be used to send alert events to this source."
      t: "`$STRING`"
    }
    auto_resolve_incident_alerts: {
      h: "Auto Resolve Incident Alerts"
      n: "auto_resolve_incident_alerts"
      r: false
      sh: "Whether alerts from this source keep counting down to auto-resolve while attached to an incident."
      t: "`$BOOLEAN`"
    }
    auto_resolve_timeout_minutes: {
      fo: "int64"
      h: "Auto Resolve Timeout Minutes"
      n: "auto_resolve_timeout_minutes"
      r: false
      sh: "When set, alerts from this source will automatically resolve after this many minutes."
      t: "`$INTEGER`"
    }
    azure_devops_options: {
      h: "Azure Devops Options"
      n: "azure_devops_options"
      r: true
      t: "`$OBJECT`"
    }
    disabled: {
      h: "Disabled"
      n: "disabled"
      r: false
      sh: "For heartbeat sources, set to true to disable monitoring"
      t: "`$BOOLEAN`"
    }
    email_options: {
      h: "Email Options"
      n: "email_options"
      r: true
      t: "`$OBJECT`"
    }
    filter_condition_groups: {
      h: "Filter Condition Groups"
      n: "filter_condition_groups"
      r: false
      sh: "Conditions an incoming event must match to be ingested from this source, evaluated against the event's payload and this source's expressions."
      t: "`$ARRAY`"
    }
    fixed_team_id: {
      h: "Fixed Team Id"
      n: "fixed_team_id"
      r: false
      sh: "When set, the team every alert from this source is attributed to."
      t: "`$STRING`"
    }
    heartbeat_options: {
      h: "Heartbeat Options"
      n: "heartbeat_options"
      r: true
      t: "`$OBJECT`"
    }
    http_custom_options: {
      h: "Http Custom Options"
      n: "http_custom_options"
      r: true
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The ID of this alert source"
      t: "`$STRING`"
    }
    jira_options: {
      h: "Jira Options"
      n: "jira_options"
      r: true
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Unique name of the alert source"
      t: "`$STRING`"
    }
    owning_team_ids: {
      h: "Owning Team Ids"
      n: "owning_team_ids"
      r: false
      sh: "IDs of teams that own this alert source"
      t: "`$ARRAY`"
    }
    rate_limit_sharding: {
      h: "Rate Limit Sharding"
      n: "rate_limit_sharding"
      r: true
      sh: "Controls how this source's ingest rate limit is split into buckets."
      t: "`$OBJECT`"
    }
    secret_token: {
      h: "Secret Token"
      n: "secret_token"
      r: false
      sh: "Secret token used to authenticate this source, if applicable."
      t: "`$STRING`"
    }
    source_type: {
      h: "Source Type"
      n: "source_type"
      r: true
      sh: "Type of alert source"
      t: "`$STRING`"
    }
    template: {
      h: "Template"
      n: "template"
      r: true
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

