    }
    notify_end_minutes_before: {
      fo: "int64"
      h: "Notify End Minutes Before"
      n: "notify_end_minutes_before"
      r: false
      sh: "Minutes before the end to send a notification to the configured channels"
      t: "`$INTEGER`"
    }
    notify_start_minutes_before: {
      fo: "int64"
      h: "Notify Start Minutes Before"
      n: "notify_start_minutes_before"
      r: false
