      h: "Reroute On End"
      n: "reroute_on_end"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Whether to retrigger firing alerts through alert routing when the window ends"
      t: "`$BOOLEAN`"
    }
    resolve_on_end: {
      h: "Resolve On End"
      n: "resolve_on_end"
      op: {
        create: {
          req: false
          type: "`$BOOLEAN`"
        }
        update: {
          req: false
          type: "`$BOOLEAN`"
        }
      }
      r: true
      sh: "Whether to automatically resolve all firing alerts that matched this window when it ends"
      t: "`$BOOLEAN`"
    }
    show_in_sidebar: {
      h: "Show In Sidebar"
      n: "show_in_sidebar"
      r: true
      sh: "Whether to show this maintenance window in the dashboard sidebar when active"
