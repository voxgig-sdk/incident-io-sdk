# Entity: alert

main: kit: entity: alert: {

  alias: field: {}

  fields: {
    alert_group_ids: {
      h: "Alert Group Ids"
      n: "alert_group_ids"
      r: false
      sh: "The IDs of every alert group this alert belongs to."
      t: "`$ARRAY`"
    }
    alert_source_id: {
      h: "Alert Source Id"
      n: "alert_source_id"
      r: true
      sh: "The ID of the alert source this alert fired on"
      t: "`$STRING`"
    }
    attributes: {
      h: "Attributes"
      n: "attributes"
      r: true
      sh: "Attribute values parsed from the alerts payload"
      t: "`$ARRAY`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "When this entry was created"
      t: "`$STRING`"
    }
    deduplication_key: {
      h: "Deduplication Key"
      n: "deduplication_key"
      r: true
      sh: "A deduplication key which uniquely references this alert from your alert source."
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "The description of the alert"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "The ID of this alert"
      t: "`$STRING`"
    }
    resolved_at: {
      fo: "date-time"
      h: "Resolved At"
      n: "resolved_at"
      r: false
      sh: "When this alert was resolved"
      t: "`$STRING`"
    }
    source_url: {
      h: "Source Url"
      n: "source_url"
      r: false
      sh: "If applicable, a link to the alert in the upstream system"
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      r: true
      sh: "Statuses of an alert"
      t: "`$STRING`"
    }
    tags: {
      h: "Tags"
      n: "tags"
      r: false
      sh: "Tags someone has applied to this alert"
      t: "`$ARRAY`"
    }
    title: {
      h: "Title"
      n: "title"
      r: true
      sh: "The title of the alert, parsed from the alert payload according to the alert source configuration"
      t: "`$STRING`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "When this alert was last updated"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "alert"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v2/alerts/{id}/actions/resolve"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FDAG4SAP5TYPT98WGR2N7W91"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v2/alerts/{id}/actions/resolve"
          q: {
            "$action": "action_resolve"
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "alerts"
            }
            {
              var: "id"
            }
            {
              lit: "actions"
            }
            {
              lit: "resolve"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.alert`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/alerts"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "query"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                ex: {
                  one_of: [
                    "01GBSQF3FHF7FWZQNWGHAVQ804"
                  ]
                }
                k: "query"
                n: "alert_group_id"
                or: "alert_group_id"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  one_of: [
                    "01GBSQF3FHF7FWZQNWGHAVQ804"
                  ]
                }
                k: "query"
                n: "alert_source"
                or: "alert_source"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  "01GBSQF3FHF7FWZQNWGHAVQ804": {
                    one_of: [
                      "01GBSQF3FHF7FWZQNWGHAVQ804"
                      "01ET65M7ZARSFZ6TFDFVQDN9AA"
                    ]
                  }
                }
                k: "query"
                n: "attribute"
                or: "attributes"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  gte: [
                    "2025-01-01"
                  ]
                }
                k: "query"
                n: "created_at"
                or: "created_at"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  is: [
                    "01GBSQF3FHF7FWZQNWGHAVQ804"
                  ]
                }
                k: "query"
                n: "deduplication_key"
                or: "deduplication_key"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  is: [
                    "true"
                  ]
                }
                k: "query"
                n: "has_note"
                or: "has_notes"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  is: [
                    "true"
                  ]
                }
                k: "query"
                n: "include_maintenance_window"
                or: "include_maintenance_window"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: 25
                k: "query"
                n: "page_size"
                or: "page_size"
                r: true
                t: "`$INTEGER`"
              }
              {
                ex: {
                  one_of: [
                    "firing"
                  ]
                }
                k: "query"
                n: "status"
                or: "status"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  one_of: [
                    "known issue"
                  ]
                }
                k: "query"
                n: "tag"
                or: "tags"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  gte: [
                    "2025-01-01"
                  ]
                }
                k: "query"
                n: "updated_at"
                or: "updated_at"
                r: false
                t: "`$OBJECT`"
              }
            ]
          }
          m: "GET"
          o: "/v2/alerts"
          q: {
            exist: [
              "page_size"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "alerts"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.alerts`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v2/alerts/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FDAG4SAP5TYPT98WGR2N7W91"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/alerts/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "alerts"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.alert`"
          }
        }
      ]
    }
  }



}
