# Entity: user

main: kit: entity: user: {

  alias: field: {}

  fields: {
    base_role: {
      h: "Base Role"
      n: "base_role"
      r: true
      t: "`$OBJECT`"
    }
    custom_roles: {
      h: "Custom Roles"
      n: "custom_roles"
      r: true
      t: "`$ARRAY`"
    }
    email: {
      h: "Email"
      n: "email"
      r: false
      sh: "Email address of the user."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier of the user"
      t: "`$STRING`"
    }
    is_active: {
      h: "Is Active"
      n: "is_active"
      r: true
      sh: "Whether the user is active."
      t: "`$BOOLEAN`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Name of the user"
      t: "`$STRING`"
    }
    role: {
      h: "Role"
      n: "role"
      r: true
      sh: "DEPRECATED: Role of the user as of March 9th 2023, this value is no longer updated."
      t: "`$STRING`"
    }
    seats: {
      h: "Seats"
      n: "seats"
      r: true
      t: "`$OBJECT`"
    }
    slack_user_id: {
      h: "Slack User Id"
      n: "slack_user_id"
      r: false
      sh: "Slack ID of the user"
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "user"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "preferred_escalation_provider"
          ]
          co: {
            id: "POST /v2/users/{user_id}/paging_provider"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "param"
                n: "id"
                or: "user_id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v2/users/{user_id}/paging_provider"
          q: {
            "$action": "paging_provider"
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              user_id: "id"
            }
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "users"
            }
            {
              var: "id"
            }
            {
              lit: "paging_provider"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/users"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "01FDAG4SAP5TYPT98WGR2N7W91"
                k: "query"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "john.doe@incident.io"
                k: "query"
                n: "email"
                or: "email"
                r: false
                t: "`$STRING`"
              }
              {
                ex: true
                k: "query"
                n: "include_inactive"
                or: "include_inactive"
                r: false
                t: "`$BOOLEAN`"
              }
              {
                ex: 25
                k: "query"
                n: "page_size"
                or: "page_size"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "U12345678"
                k: "query"
                n: "slack_user_id"
                or: "slack_user_id"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/users"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "users"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.users`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v2/users/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/users/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "users"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.user`"
          }
        }
      ]
    }
  }



}
