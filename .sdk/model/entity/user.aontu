                orig: "slack_user_id"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v2/users"
          parts: [
            "v2"
            "users"
          ]
          select: {
            exist: [
              "after"
              "email"
              "include_inactive"
              "page_size"
              "slack_user_id"
            ]
          }
          transform: {
            req: "`reqdata`"
