# Entity: workflow

main: kit: entity: workflow: {

  alias: field: {}

  fields: {
    annotations: {
      h: "Annotations"
      n: "annotations"
      r: false
      sh: "Annotations that track metadata about this resource"
      t: "`$OBJECT`"
    }
    auto_run_mode: {
      h: "Auto Run Mode"
      n: "auto_run_mode"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "Whether the workflow runs immediately, or asks for confirmation in the incident channel first."
      t: "`$STRING`"
    }
    condition_groups: {
      h: "Condition Groups"
      n: "condition_groups"
      r: true
      sh: "Conditions that apply to the workflow trigger"
      t: "`$ARRAY`"
    }
    continue_on_step_error: {
      h: "Continue On Step Error"
      n: "continue_on_step_error"
      r: true
      sh: "Whether to continue executing the workflow if a step fails"
      t: "`$BOOLEAN`"
    }
    delay: {
      h: "Delay"
      n: "delay"
      r: true
      t: "`$OBJECT`"
    }
    expressions: {
      h: "Expressions"
      n: "expressions"
      r: true
      sh: "The expressions to use in the workflow"
      t: "`$ARRAY`"
    }
    folder: {
      h: "Folder"
      n: "folder"
      r: false
      sh: "Folder to display the workflow in"
      t: "`$STRING`"
    }
    form_fields: {
      h: "Form Fields"
      n: "form_fields"
      r: false
      sh: "User-configured form fields available in the workflow scope."
      t: "`$ARRAY`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the workflow"
      t: "`$STRING`"
    }
    include_private_escalations: {
      h: "Include Private Escalations"
      n: "include_private_escalations"
      op: {
        list: {
          req: true
          type: "`$BOOLEAN`"
        }
      }
      r: false
      sh: "Whether to include private escalations"
      t: "`$BOOLEAN`"
    }
    include_private_incidents: {
      h: "Include Private Incidents"
      n: "include_private_incidents"
      op: {
        list: {
          req: true
          type: "`$BOOLEAN`"
        }
      }
      r: false
      sh: "DEPRECATED: use `private_incident_scope` instead."
      t: "`$BOOLEAN`"
    }
    management_meta: {
      h: "Management Meta"
      n: "management_meta"
      r: true
      t: "`$OBJECT`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Name provided by the user when creating the workflow"
      t: "`$STRING`"
    }
    once_for: {
      h: "Once For"
      n: "once_for"
      r: true
      sh: "This workflow will run 'once for' a list of references"
      t: "`$ARRAY`"
    }
    owning_team_ids: {
      h: "Owning Team Ids"
      n: "owning_team_ids"
      r: false
      sh: "IDs of the teams that own this workflow"
      t: "`$ARRAY`"
    }
    private_incident_scope: {
      h: "Private Incident Scope"
      n: "private_incident_scope"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "Which private incidents this workflow acts on: every private incident (all), those an owning team can see (owning_teams), or none"
      t: "`$STRING`"
    }
    runs_from: {
      fo: "date-time"
      h: "Runs From"
      n: "runs_from"
      r: false
      sh: "The time from which this workflow will run on incidents"
      t: "`$STRING`"
    }
    runs_on_incident_modes: {
      h: "Runs On Incident Modes"
      n: "runs_on_incident_modes"
      r: true
      sh: "Which incident modes should this workflow run on?"
      t: "`$ARRAY`"
    }
    runs_on_incidents: {
      h: "Runs On Incidents"
      n: "runs_on_incidents"
      r: true
      sh: "Which incidents should the workflow be applied to?"
      t: "`$STRING`"
    }
    shortform: {
      h: "Shortform"
      n: "shortform"
      r: false
      sh: "The shortform used to trigger this workflow (only applicable for manual triggers)"
      t: "`$STRING`"
    }
    skip_step_upgrades: {
      h: "Skip Step Upgrades"
      n: "skip_step_upgrades"
      r: false
      sh: "Skips workflow step upgrades, when the parameters for an existing workflow step change"
      t: "`$BOOLEAN`"
    }
    state: {
      h: "State"
      n: "state"
      op: {
        list: {
          req: true
          type: "`$STRING`"
        }
      }
      r: false
      sh: "What state this workflow is in"
      t: "`$STRING`"
    }
    steps: {
      h: "Steps"
      n: "steps"
      r: true
      sh: "Steps that are executed as part of the workflow"
      t: "`$ARRAY`"
    }
    trigger: {
      h: "Trigger"
      n: "trigger"
      r: true
      sh: "Trigger to set on the workflow"
      t: "`$STRING`"
    }
    version: {
      fo: "int64"
      h: "Version"
      n: "version"
      r: true
      sh: "Revision of the workflow, uniquely identifying it's version"
      t: "`$INTEGER`"
    }
    workflow: {
      h: "Workflow"
      n: "workflow"
      r: true
      t: "`$OBJECT`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "workflow"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "annotations"
            "auto_run_mode"
            "condition_groups"
            "continue_on_step_error"
            "delay"
            "expressions"
            "folder"
            "form_fields"
            "include_private_escalations"
            "include_private_incidents"
            "name"
            "once_for"
            "owning_team_ids"
            "private_incident_scope"
            "runs_on_incident_modes"
            "runs_on_incidents"
            "shortform"
            "state"
            "steps"
            "trigger"
          ]
          co: {
            id: "POST /v2/workflows"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v2/workflows"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "workflows"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.workflow`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/workflows"
            source: "openapi3"
            version: 2
          }
          m: "GET"
          o: "/v2/workflows"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "workflows"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.workflows`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v2/workflows/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: false
                k: "query"
                n: "skip_step_upgrade"
                or: "skip_step_upgrades"
                r: false
                t: "`$BOOLEAN`"
              }
            ]
          }
          m: "GET"
          o: "/v2/workflows/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "workflows"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.workflow`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /v2/workflows/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/v2/workflows/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "workflows"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          bf: [
            "annotations"
            "auto_run_mode"
            "condition_groups"
            "continue_on_step_error"
            "delay"
            "expressions"
            "folder"
            "form_fields"
            "include_private_escalations"
            "include_private_incidents"
            "name"
            "once_for"
            "owning_team_ids"
            "private_incident_scope"
            "runs_on_incident_modes"
            "runs_on_incidents"
            "shortform"
            "skip_step_upgrades"
            "state"
            "steps"
          ]
          co: {
            id: "PUT /v2/workflows/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/v2/workflows/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "workflows"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.workflow`"
          }
        }
      ]
    }
  }



}
