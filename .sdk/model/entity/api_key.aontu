# Entity: api_key

main: kit: entity: api_key: {

  alias: field: {}

  fields: {
    comments: {
      h: "Comments"
      n: "comments"
      r: false
      sh: "Freeform notes about this API key"
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "When the API key was created"
      t: "`$STRING`"
    }
    creator: {
      h: "Creator"
      n: "creator"
      r: true
      t: "`$OBJECT`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for this API key"
      t: "`$STRING`"
    }
    last_used_at: {
      fo: "date-time"
      h: "Last Used At"
      n: "last_used_at"
      r: false
      sh: "When the key was last used to authenticate a request"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "The name of the API key, for the user's reference"
      t: "`$STRING`"
    }
    role_names: {
      h: "Role Names"
      n: "role_names"
      r: true
      sh: "Account-level roles to assign to the API key."
      t: "`$ARRAY`"
    }
    roles: {
      h: "Roles"
      n: "roles"
      r: true
      sh: "The account-level roles assigned to this API key"
      t: "`$ARRAY`"
    }
    team_ids: {
      h: "Team Ids"
      n: "team_ids"
      r: true
      sh: "IDs of teams that this API key is scoped to"
      t: "`$ARRAY`"
    }
    team_role_names: {
      h: "Team Role Names"
      n: "team_role_names"
      r: true
      sh: "Roles to grant for the teams specified in `team_ids`."
      t: "`$ARRAY`"
    }
    team_roles: {
      h: "Team Roles"
      n: "team_roles"
      r: true
      sh: "The team-level roles assigned to this API key"
      t: "`$ARRAY`"
    }
    token_last_issued_at: {
      fo: "date-time"
      h: "Token Last Issued At"
      n: "token_last_issued_at"
      r: true
      sh: "When the current token for this API was last issued."
      t: "`$STRING`"
    }
  }

