# Entity: secret

main: kit: entity: secret: {

  alias: field: {}

  fields: {
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      sh: "Optional description of what this secret is for"
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for this secret"
      t: "`$STRING`"
    }
    last_four_chars: {
      h: "Last Four Chars"
      n: "last_four_chars"
      r: false
      sh: "The last four characters of the current value, for masked display."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: true
      sh: "Human-readable name, unique within the organisation amongst unarchived secrets"
      t: "`$STRING`"
    }
    owning_team_ids: {
      h: "Owning Team Ids"
      n: "owning_team_ids"
      op: {
        list: {
          req: true
          type: "`$ARRAY`"
        }
        update: {
          req: true
          type: "`$ARRAY`"
        }
      }
      r: false
      sh: "IDs of the teams that own this secret."
      t: "`$ARRAY`"
    }
    secret: {
      h: "Secret"
      n: "secret"
      r: true
      sh: "A secret is a named credential that workflows can reference, for example an auth token for an outgoing webhook."
      t: "`$OBJECT`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      t: "`$STRING`"
    }
    value: {
      h: "Value"
      n: "value"
      r: true
      sh: "The secret's plaintext value."
      t: "`$STRING`"
    }
    version: {
      fo: "int64"
      h: "Version"
      n: "version"
      r: true
      sh: "The current version number, incremented on each rotation"
      t: "`$INTEGER`"
    }
    versions: {
      h: "Versions"
      n: "versions"
      r: true
      sh: "The secret's versions, newest first"
      t: "`$ARRAY`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "secret"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "value"
          ]
          co: {
            id: "POST /v2/secrets/{id}/actions/rotate"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v2/secrets/{id}/actions/rotate"
          q: {
            "$action": "action_rotate"
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "secrets"
            }
            {
              var: "id"
            }
            {
              lit: "actions"
            }
            {
              lit: "rotate"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.secret`"
          }
        }
        {
          bf: [
            "description"
            "name"
            "owning_team_ids"
            "value"
          ]
          co: {
            id: "POST /v2/secrets"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v2/secrets"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "secrets"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.secret`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v2/secrets"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "query"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 25
                k: "query"
                n: "page_size"
                or: "page_size"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: [
                  "abc123"
                ]
                k: "query"
                n: "team_id"
                or: "team_ids"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/v2/secrets"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "secrets"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.secrets`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v2/secrets/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/secrets/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "secrets"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.secret`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /v2/secrets/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/v2/secrets/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "secrets"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          bf: [
            "description"
            "name"
            "owning_team_ids"
          ]
          co: {
            id: "PUT /v2/secrets/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FCNDV6P870EA6S7TK1DSYDG0"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PUT"
          o: "/v2/secrets/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "secrets"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.secret`"
          }
        }
      ]
    }
  }



}
