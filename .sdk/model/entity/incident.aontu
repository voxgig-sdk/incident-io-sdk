# Entity: incident

main: kit: entity: incident: {

  alias: field: {}

  fields: {
    call_url: {
      h: "Call Url"
      n: "call_url"
      r: false
      sh: "The call URL attached to this incident"
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: true
      sh: "When the incident was created"
      t: "`$STRING`"
    }
    creator: {
      h: "Creator"
      n: "creator"
      r: true
      t: "`$OBJECT`"
    }
    custom_field_entries: {
      h: "Custom Field Entries"
      n: "custom_field_entries"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "Custom field entries for this incident"
      t: "`$ARRAY`"
    }
    debriefs: {
      h: "Debriefs"
      n: "debriefs"
      r: false
      sh: "Debriefs scheduled for this incident, ordered by start time."
      t: "`$ARRAY`"
    }
    duration_metrics: {
      h: "Duration Metrics"
      n: "duration_metrics"
      r: false
      sh: "Incident duration metrics and their measurements for this incident"
      t: "`$ARRAY`"
    }
    external_issue_reference: {
      h: "External Issue Reference"
      n: "external_issue_reference"
      r: true
      t: "`$OBJECT`"
    }
    has_debrief: {
      h: "Has Debrief"
      n: "has_debrief"
      r: false
      sh: "If this incident has a debrief attached"
      t: "`$BOOLEAN`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "Unique identifier for the incident"
      t: "`$STRING`"
    }
    idempotency_key: {
      h: "Idempotency Key"
      n: "idempotency_key"
      r: true
      sh: "Unique string used to de-duplicate incident create requests"
      t: "`$STRING`"
    }
    incident_role_assignments: {
      h: "Incident Role Assignments"
      n: "incident_role_assignments"
      op: {
        create: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "A list of who is assigned to each role for this incident"
      t: "`$ARRAY`"
    }
    incident_status: {
      h: "Incident Status"
      n: "incident_status"
      r: true
      t: "`$OBJECT`"
    }
    incident_status_id: {
      h: "Incident Status Id"
      n: "incident_status_id"
      r: false
      sh: "Incident status to assign to the incident"
      t: "`$STRING`"
    }
    incident_timestamp_values: {
      h: "Incident Timestamp Values"
      n: "incident_timestamp_values"
      r: false
      sh: "Incident lifecycle events and when they occurred"
      t: "`$ARRAY`"
    }
    incident_type: {
      h: "Incident Type"
      n: "incident_type"
      r: true
      t: "`$OBJECT`"
    }
    incident_type_id: {
      h: "Incident Type Id"
      n: "incident_type_id"
      r: false
      sh: "Incident type to create this incident as"
      t: "`$STRING`"
    }
    last_activity_at: {
      fo: "date-time"
      h: "Last Activity At"
      n: "last_activity_at"
      r: true
      sh: "When the incident last recorded 'activity'"
      t: "`$STRING`"
    }
    mode: {
      h: "Mode"
      n: "mode"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Whether the incident is real, a test, a tutorial, or importing as a retrospective incident"
      t: "`$STRING`"
    }
    ms_teams_channel_url: {
      h: "Ms Teams Channel Url"
      n: "ms_teams_channel_url"
      r: false
      sh: "URL to link to the Microsoft Teams channel"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Explanation of the incident"
      t: "`$STRING`"
    }
    permalink: {
      h: "Permalink"
      n: "permalink"
      r: false
      sh: "A permanent link to the homepage for this incident"
      t: "`$STRING`"
    }
    postmortem_document_ids: {
      h: "Postmortem Document Ids"
      n: "postmortem_document_ids"
      r: false
      sh: "An array of IDs of postmortem documents for this incident"
      t: "`$ARRAY`"
    }
    postmortem_document_url: {
      h: "Postmortem Document Url"
      n: "postmortem_document_url"
      r: false
      sh: "The URL of the incident post-mortem document"
      t: "`$STRING`"
    }
    reference: {
      h: "Reference"
      n: "reference"
      r: true
      sh: "Reference to this incident, as displayed across the product"
      t: "`$STRING`"
    }
    retrospective_incident_options: {
      h: "Retrospective Incident Options"
      n: "retrospective_incident_options"
      r: false
      t: "`$OBJECT`"
    }
    severity: {
      h: "Severity"
      n: "severity"
      r: true
      t: "`$OBJECT`"
    }
    severity_id: {
      h: "Severity Id"
      n: "severity_id"
      r: false
      sh: "Severity to create incident as"
      t: "`$STRING`"
    }
    slack_channel_id: {
      h: "Slack Channel Id"
      n: "slack_channel_id"
      r: true
      sh: "ID of the Slack channel in the organisation Slack workspace."
      t: "`$STRING`"
    }
    slack_channel_name: {
      h: "Slack Channel Name"
      n: "slack_channel_name"
      r: false
      sh: "Name of the slack channel"
      t: "`$STRING`"
    }
    slack_channel_name_override: {
      h: "Slack Channel Name Override"
      n: "slack_channel_name_override"
      r: false
      sh: "Name of the Slack channel to create for this incident"
      t: "`$STRING`"
    }
    slack_channel_url: {
      h: "Slack Channel Url"
      n: "slack_channel_url"
      r: false
      sh: "URL to link to the slack channel"
      t: "`$STRING`"
    }
    slack_team_id: {
      h: "Slack Team Id"
      n: "slack_team_id"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "ID of the Slack team / workspace."
      t: "`$STRING`"
    }
    source_message_channel_id: {
      h: "Source Message Channel Id"
      n: "source_message_channel_id"
      r: false
      sh: "Channel ID of the source message, if this incident was created from one"
      t: "`$STRING`"
    }
    source_message_timestamp: {
      h: "Source Message Timestamp"
      n: "source_message_timestamp"
      r: false
      sh: "Timestamp of the source message, if this incident was created from one"
      t: "`$STRING`"
    }
    status: {
      h: "Status"
      n: "status"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Current status of the incident"
      t: "`$STRING`"
    }
    summary: {
      h: "Summary"
      n: "summary"
      r: false
      sh: "Detailed description of the incident"
      t: "`$STRING`"
    }
    team_ids: {
      h: "Team Ids"
      n: "team_ids"
      r: true
      sh: "IDs of the teams that own this incident, resolved from your team settings."
      t: "`$ARRAY`"
    }
    timestamps: {
      h: "Timestamps"
      n: "timestamps"
      r: false
      sh: "Incident lifecycle events and when they last occurred"
      t: "`$ARRAY`"
    }
    updated_at: {
      fo: "date-time"
      h: "Updated At"
      n: "updated_at"
      r: true
      sh: "When the incident was last updated"
      t: "`$STRING`"
    }
    visibility: {
      h: "Visibility"
      n: "visibility"
      r: true
      sh: "Whether the incident should be open to anyone in your Slack workspace (public), or invite-only (private)."
      t: "`$STRING`"
    }
    workload_minutes_late: {
      fo: "double"
      h: "Workload Minutes Late"
      n: "workload_minutes_late"
      r: false
      sh: "Amount of time spent on the incident in late hours"
      t: "`$NUMBER`"
    }
    workload_minutes_sleeping: {
      fo: "double"
      h: "Workload Minutes Sleeping"
      n: "workload_minutes_sleeping"
      r: false
      sh: "Amount of time spent on the incident in sleeping hours"
      t: "`$NUMBER`"
    }
    workload_minutes_total: {
      fo: "double"
      h: "Workload Minutes Total"
      n: "workload_minutes_total"
      r: false
      sh: "Amount of time spent on the incident in total"
      t: "`$NUMBER`"
    }
    workload_minutes_working: {
      fo: "double"
      h: "Workload Minutes Working"
      n: "workload_minutes_working"
      r: false
      sh: "Amount of time spent on the incident in working hours"
      t: "`$NUMBER`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "incident"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "incident"
            "notify_incident_channel"
          ]
          co: {
            id: "POST /v2/incidents/{id}/actions/edit"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01G18REBY9AYH6CMWCJ2CVCYCH"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v2/incidents/{id}/actions/edit"
          q: {
            "$action": "action_edit"
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "incidents"
            }
            {
              var: "id"
            }
            {
              lit: "actions"
            }
            {
              lit: "edit"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.incident`"
          }
        }
        {
          bf: [
            "custom_field_entries"
            "idempotency_key"
            "incident_role_assignments"
            "incident_type_id"
            "mode"
            "name"
            "severity_id"
            "slack_team_id"
            "source_message_channel_id"
            "source_message_timestamp"
            "status"
            "summary"
            "visibility"
          ]
          co: {
            id: "POST /v1/incidents"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v1/incidents"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "incidents"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.incident`"
          }
        }
        {
          bf: [
            "custom_field_entries"
            "idempotency_key"
            "incident_role_assignments"
            "incident_status_id"
            "incident_timestamp_values"
            "incident_type_id"
            "mode"
            "name"
            "retrospective_incident_options"
            "severity_id"
            "slack_channel_name_override"
            "slack_team_id"
            "summary"
            "visibility"
          ]
          co: {
            id: "POST /v2/incidents"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/v2/incidents"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "incidents"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.incident`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/incidents"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "01FDAG4SAP5TYPT98WGR2N7W91"
                k: "query"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 25
                k: "query"
                n: "page_size"
                or: "page_size"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: [
                  "declined"
                ]
                k: "query"
                n: "status"
                or: "status"
                r: false
                t: "`$ARRAY`"
              }
            ]
          }
          m: "GET"
          o: "/v1/incidents"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "incidents"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.incidents`"
          }
        }
        {
          co: {
            id: "GET /v2/incidents"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "01FDAG4SAP5TYPT98WGR2N7W91"
                k: "query"
                n: "after"
                or: "after"
                r: false
                t: "`$STRING`"
              }
              {
                ex: {
                  gte: [
                    "2024-05-01"
                  ]
                }
                k: "query"
                n: "created_at"
                or: "created_at"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  "01GBSQF3FHF7FWZQNWGHAVQ804": {
                    one_of: [
                      "01GBSQF3FHF7FWZQNWGHAVQ804"
                      "01ET65M7ZARSFZ6TFDFVQDN9AA"
                    ]
                  }
                }
                k: "query"
                n: "custom_field"
                or: "custom_field"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: "all"
                k: "query"
                n: "filter_mode"
                or: "filter_mode"
                r: false
                t: "`$STRING`"
              }
              {
                ex: {
                  "01GBSQF3FHF7FWZQNWGHAVQ804": {
                    one_of: [
                      "01GBSQF3FHF7FWZQNWGHAVQ804"
                      "01ET65M7ZARSFZ6TFDFVQDN9AA"
                    ]
                  }
                }
                k: "query"
                n: "incident_role"
                or: "incident_role"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  one_of: [
                    "01GBSQF3FHF7FWZQNWGHAVQ804"
                  ]
                }
                k: "query"
                n: "incident_type"
                or: "incident_type"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  one_of: [
                    "retrospective"
                  ]
                }
                k: "query"
                n: "mode"
                or: "mode"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: 25
                k: "query"
                n: "page_size"
                or: "page_size"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: {
                  one_of: [
                    "01GBSQF3FHF7FWZQNWGHAVQ804"
                  ]
                }
                k: "query"
                n: "severity"
                or: "severity"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: "created_at_newest_first"
                k: "query"
                n: "sort_by"
                or: "sort_by"
                r: false
                t: "`$STRING`"
              }
              {
                ex: {
                  one_of: [
                    "01GBSQF3FHF7FWZQNWGHAVQ804"
                  ]
                }
                k: "query"
                n: "status"
                or: "status"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  one_of: [
                    "active"
                  ]
                }
                k: "query"
                n: "status_category"
                or: "status_category"
                r: false
                t: "`$OBJECT`"
              }
              {
                ex: {
                  gte: [
                    "2024-05-01"
                  ]
                }
                k: "query"
                n: "updated_at"
                or: "updated_at"
                r: false
                t: "`$OBJECT`"
              }
            ]
          }
          m: "GET"
          o: "/v2/incidents"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "incidents"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.incidents`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/incidents/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FDAG4SAP5TYPT98WGR2N7W91"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/incidents/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "incidents"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.incident`"
          }
        }
        {
          co: {
            id: "GET /v2/incidents/{id}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "01FDAG4SAP5TYPT98WGR2N7W91"
                k: "param"
                n: "id"
                or: "id"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v2/incidents/{id}"
          q: {
            exist: [
              "id"
            ]
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v2"
            }
            {
              lit: "incidents"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.incident`"
          }
        }
      ]
    }
  }



}
